{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cv2embodied:schema:book-manifest:v1",
  "title": "CV2Embodied Book Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "book", "chapters"],
  "properties": {
    "schema_version": {"const": 1},
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "prd", "chapter_count"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "prd": {"type": "string", "minLength": 1},
        "chapter_count": {"const": 22}
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "part",
          "title",
          "document",
          "dependencies",
          "experiments",
          "claims",
          "figures",
          "automatic_driving_role",
          "resource_tiers",
          "status"
        ],
        "properties": {
          "number": {"type": "integer", "minimum": 1, "maximum": 22},
          "part": {"type": "integer", "minimum": 1, "maximum": 7},
          "title": {"type": "string", "minLength": 1},
          "document": {"type": ["string", "null"]},
          "dependencies": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1, "maximum": 22},
            "uniqueItems": true
          },
          "experiments": {"type": "array", "items": {"type": "string", "pattern": "^EXP-[0-9]{2}-[0-9]{2}$"}, "uniqueItems": true},
          "claims": {"type": "array", "items": {"type": "string", "pattern": "^CLAIM-[0-9]{2}-[0-9]{2}$"}, "uniqueItems": true},
          "figures": {"type": "array", "items": {"type": "string", "pattern": "^(FIG|TAB)-[0-9]{2}-[0-9]{2}$"}, "uniqueItems": true},
          "automatic_driving_role": {"type": ["string", "null"]},
          "resource_tiers": {
            "type": "array",
            "items": {"type": "string", "enum": ["S", "M", "L1", "L2"]},
            "minItems": 1,
            "uniqueItems": true
          },
          "status": {"type": "object"}
        }
      }
    }
  }
}
